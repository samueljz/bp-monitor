# Environment variables for bp_monitor
# Copy this file to .env (or .env.local) and fill in your values.
# Never commit the actual .env / .env.local files — they are gitignored.

# Google OAuth 2.0 Client ID for Drive sync (optional).
# Create one at https://console.cloud.google.com/ → APIs & Services → Credentials
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
